// Cloudflare Worker for onlyatthekiosk.com
// Build: npm run build:worker    Deploy: npx wrangler deploy
// Secrets used by /api (Airtable, Shopify, …) are set on the Worker in the
// Cloudflare dashboard (Settings → Variables and Secrets), not in this file.
{
  "name": "onlyatthekiosk-website",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-10-01",
  // Build the site into dist/ on every deploy, so `npx wrangler deploy` works
  // even when the dashboard's build command is left empty.
  "build": { "command": "bash scripts/build-worker.sh" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  // The site's own domains. A deploy attaches them to this Worker and creates
  // their DNS records and certificates in the onlyatthekiosk.com zone. They
  // must not also be custom domains on a Pages project (remove them there).
  "routes": [
    { "pattern": "onlyatthekiosk.com", "custom_domain": true },
    { "pattern": "www.onlyatthekiosk.com", "custom_domain": true }
  ],
  // Empty block: preview builds need this key (Wrangler 4.135+); no separate
  // bindings/vars for previews yet. See Workers Previews configuration docs.
  "previews": {},
  // Accounts (members, sign-in codes, saves, check-in). See docs/ACCOUNTS.md.
  // New migrations: npx wrangler d1 migrations apply kiosk-accounts --remote
  "d1_databases": [
    { "binding": "DB", "database_name": "kiosk-accounts", "database_id": "539499f7-d26e-4e19-b5e8-6c514397672b", "migrations_dir": "migrations" }
  ],
  // Sign-in codes and welcome emails go out through Cloudflare Email Service
  // (Workers Paid; onlyatthekiosk.com onboarded under Email Service > Email
  // Sending). Sender: MAIL_FROM, default members@onlyatthekiosk.com.
  "send_email": [
    { "name": "EMAIL" }
  ]
}
