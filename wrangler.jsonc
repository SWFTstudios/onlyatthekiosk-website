// Cloudflare Worker for onlyatthekiosk.com
// Build: npm run build:worker    Deploy: npx wrangler deploy
// Secrets used by /api (Airtable, Shopify, …) are set on the Worker in the
// Cloudflare dashboard (Settings → Variables and Secrets), not in this file.
{
  "name": "onlyatthekiosk",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  // Create with: npx wrangler d1 create kiosk-accounts
  // Then replace database_id below and set SHOPIFY_CUSTOMER_CLIENT_ID / SECRET.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kiosk-accounts",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ]
}
