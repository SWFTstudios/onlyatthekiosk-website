// Cloudflare Worker for onlyatthekiosk.com
// Build: npm run build:worker    Deploy: npx wrangler deploy
// Secrets used by /api (Airtable, Shopify, …) are set on the Worker in the
// Cloudflare dashboard (Settings → Variables and Secrets), not in this file.
{
  "name": "onlyatthekiosk",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
  // onlyatthekiosk.com and www are served by the Cloudflare Pages project
  // "onlyatthekiosk-website" (Custom domains tab). Don't add custom-domain
  // routes here while Pages serves the site, or a Worker deploy would try to
  // take the domain over.
  // Accounts (sign-in, wishlist, cart, check-in) need a D1 database. Until it
  // exists the site runs without it and shows "Accounts are coming soon".
  // To switch accounts on:
  //   npx wrangler d1 create kiosk-accounts
  //   then add this block above, with the database_id that command prints,
  //   and run: npx wrangler d1 migrations apply kiosk-accounts
  //   "d1_databases": [
  //     { "binding": "DB", "database_name": "kiosk-accounts", "database_id": "<id>", "migrations_dir": "migrations" }
  //   ]
  // Also set SHOPIFY_CUSTOMER_CLIENT_ID / SECRET (see docs/ACCOUNTS.md).
}
